[Unit]
Description=camtest — ESP32-CAM → VPS bench receiver
Documentation=file:///opt/camtest/server.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camtest
Group=camtest
EnvironmentFile=-/etc/camtest/camtest.env
Environment=CAMTEST_ROOT=/var/lib/camtest
Environment=CAMTEST_CERT=/etc/camtest/tls.crt
Environment=CAMTEST_KEY=/etc/camtest/tls.key
ExecStart=/usr/bin/python3 -u /opt/camtest/server.py
Restart=on-failure
RestartSec=2

# bind 80/443 without root; write only /var/lib/camtest
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/camtest
MemoryMax=128M

[Install]
WantedBy=multi-user.target
