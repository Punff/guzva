# guzva.service — systemd unit for the venue-stills service (PLAN §8).
# Installed to /etc/systemd/system/guzva.service.
#
# BENCH CUTOVER shape: the binary terminates TLS itself with the existing
# epoch self-signed cert (/etc/guzva/tls.* — the firmware's embedded CA
# already trusts it, so no re-flash). When autocert + domain land (§8),
# drop -tls-cert/-tls-key and point -listen at the autocert ports.
# Secrets come from /etc/guzva/guzva.env (root-only, EnvironmentFile).
# Static binary, no container, no Docker.

[Unit]
Description=guzva venue-stills service
Documentation=file:///usr/local/bin/guzva
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guzva
Group=guzva
EnvironmentFile=/etc/guzva/guzva.env
ExecStart=/usr/local/bin/guzva serve -listen :443 -tls-cert /etc/guzva/tls.crt -tls-key /etc/guzva/tls.key -data /var/lib/guzva -retain-hours 48

# Bind :443 without running as root (bind permission only, nothing else).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Restart always, after a short pause: the <2 s restart gap is absorbed by
# idempotent ingest (a duplicate capture_id gets 409 with the same body as a
# 201) and by the device retrying on its next tick (PLAN §8, deploy section).
Restart=always
RestartSec=2

# Hardening: no privilege escalation, private /tmp, read-only system dirs
# except the data dir (SQLite WAL + venues/ live there).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guzva

[Install]
WantedBy=multi-user.target
